{
  "info": {
    "name": "Acara 18 - JSON Encoding & HTTP Status Code",
    "description": "Pengujian Response::json() (envelope seragam) dan taksonomi kode status HTTP. Jalankan folder berurutan (Collection Runner): 'Sukses' lalu 'Error'.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"Content-Type application/json\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
          "pm.test(\"Envelope seragam (success, message, data, errors, timestamp)\", () => {",
          "  const j = pm.response.json();",
          "  [\"success\", \"message\", \"data\", \"errors\", \"timestamp\"].forEach(k => pm.expect(j).to.have.property(k));",
          "  pm.expect(j.success).to.eql(pm.response.code < 400);",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Sukses (2xx)",
      "item": [
        {
          "name": "1. POST tambah mahasiswa (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test(\"success true & ada id\", () => { pm.expect(j.success).to.be.true; pm.expect(j.data.id).to.exist; });",
                  "pm.collectionVariables.set(\"new_id\", j.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/mahasiswa",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "mahasiswa"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nim\": \"240101003\",\n  \"nama\": \"Andi Saputra\",\n  \"prodi\": \"Teknik Informatika\"\n}",
